{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-no-env-files.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "name": "check-no-env-files",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh -c 'f=\"$1\"; case \"$f\" in api/*.py) cd \"$CLAUDE_PROJECT_DIR/api\" && ruff format \"$CLAUDE_PROJECT_DIR/$f\" && ruff check --fix \"$CLAUDE_PROJECT_DIR/$f\" ;; esac' _ \"$CLAUDE_TOOL_INPUT_FILE_PATH\"",
            "name": "ruff-format-on-edit",
            "timeout": 15000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "sh -c 'f=\"$1\"; case \"$f\" in code/src/*.ts|code/src/*.tsx) cd \"$CLAUDE_PROJECT_DIR/code\" && npx vitest related \"$CLAUDE_PROJECT_DIR/$f\" --run ;; esac' _ \"$CLAUDE_TOOL_INPUT_FILE_PATH\"",
            "name": "vitest-related-on-edit",
            "timeout": 30000,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(rtk git status *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk git show *)",
      "Bash(rtk git branch *)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)",
      "Bash(rtk make help)",
      "Bash(rtk docker ps *)",
      "Bash(rtk docker images *)",
      "Bash(rtk docker compose ps *)",
      "Bash(rtk docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh pr checks *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh issue list *)",
      "Bash(rtk gh run list *)",
      "Bash(rtk gh run view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl patch *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(argocd *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(bao write *)",
      "Bash(vault write *)",
      "Bash(docker push *)",
      "Bash(npm publish *)",
      "Bash(twine upload *)",
      "Bash(rm -rf *)",
      "Bash(rtk git push *)",
      "Bash(rtk gh pr create *)",
      "Bash(rtk gh pr merge *)",
      "Bash(rtk gh release *)",
      "Bash(rtk gh repo *)",
      "Bash(rtk kubectl apply *)",
      "Bash(rtk kubectl delete *)",
      "Bash(rtk kubectl patch *)",
      "Bash(rtk helm install *)",
      "Bash(rtk helm upgrade *)",
      "Bash(rtk helm uninstall *)",
      "Bash(rtk argocd *)",
      "Bash(rtk terraform apply *)",
      "Bash(rtk terraform destroy *)",
      "Bash(rtk tofu apply *)",
      "Bash(rtk tofu destroy *)",
      "Bash(rtk bao write *)",
      "Bash(rtk vault write *)",
      "Bash(rtk docker push *)",
      "Bash(rtk npm publish *)",
      "Bash(rtk twine upload *)",
      "Bash(rtk rm -rf *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.vault-token)",
      "Read(!.env.example)",
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.mypy_cache/**)",
      "Read(**/.ruff_cache/**)",
      "Read(**/.terraform/**)",
      "Read(**/coverage/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)"
    ]
  }
}
