# ─── Auth ──────────────────────────────────────────────────
# Set ENVIRONMENT=production to enforce secure-config guards at startup.
ENVIRONMENT=development
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
# Preferred: a bcrypt hash (required in production). Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Plaintext fallback for local development only (ignored if ADMIN_PASSWORD_HASH is set).
ADMIN_PASSWORD=

# ─── LDAP (optionnel) ──────────────────────────────────────
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ─── Chemins ───────────────────────────────────────────────
# Répertoire contenant les sous-dossiers de projets docker-compose
PROJECTS_PATH=/opt/projects

# ─── Ports ─────────────────────────────────────────────────
FRONTEND_PORT=3000

# ─── URL de l'API (vue depuis le navigateur, bakée au build) ─
# Laisser vide si un proxy reverse (nginx, Caddy...) proxifie /api
# Sinon : http://<hote>:<port_api>  ex: http://localhost:8000
VITE_API_URL=http://localhost:8000
